# Salin ke .env lalu isi:  cp .env.example .env

# --- Bot ---
BOT_NAME=WaBot
PREFIX=.
DB_PATH=whatsapp.db
LOG_LEVEL=WARN                 # DEBUG | INFO | WARN | ERROR

# Login pakai kode pairing (tanpa scan QR). Kosongin = pakai QR. Format: 628xxxxxxxxxx
PAIR_PHONE=

# Abaikan pesan yang lebih lama dari ini (detik), biar backlog saat bot baru nyala nggak dieksekusi
IGNORE_OLDER_THAN_SECS=120

# --- Tools ---
# Selisih zona waktu dari UTC untuk command .time (WIB=7, WITA=8, WIT=9)
TZ_OFFSET_HOURS=7

# --- Downloader (butuh yt-dlp & ffmpeg di PATH) ---
DL_MAX_MB=64
DL_TIMEOUT_SECS=300
DL_CONCURRENCY=2
